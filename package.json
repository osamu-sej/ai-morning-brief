{
  "name": "ai-morning-brief",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Free, local-first AI news briefing pipeline for NotebookLM",
  "scripts": {
    "amb": "node src/cli.mjs",
    "doctor": "node src/cli.mjs doctor",
    "setup": "node src/cli.mjs setup",
    "dry-run": "node src/cli.mjs run --dry-run",
    "build:ocr": "mkdir -p runtime/bin && swiftc tools/vision-ocr.swift -o runtime/bin/vision-ocr",
    "test": "node --test test/*.test.mjs"
  },
  "engines": {
    "node": ">=22"
  }
}
